# ==============================================================================
# Lyftr AI Full-Stack LLM Chatbot — Environment Configuration
# Copy this file to .env and fill in real API keys before starting.
# Never commit real API keys to version control.
# ==============================================================================

# SQLite database URL (Docker uses /data volume; for local dev use sqlite:///./data/chatbot.db)
DATABASE_URL=sqlite:////data/chatbot.db

# Comma-separated pool of at least TWO distinct Gemini API keys (internal IDs: key_1, key_2, ...)
LLM_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2

# Default LiteLLM Gemini model
LLM_MODEL=gemini/gemini-3.1-flash-lite

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# LiteLLM response caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Enable X-Simulate-Failure header support (keep false in production)
ENABLE_FAILURE_SIMULATION=false

# System prompt prepended to every LLM conversation
SYSTEM_PROMPT=You are a helpful, concise, and accurate AI assistant.

# Frontend API base URL (used at Vite build/dev time)
VITE_API_BASE_URL=http://localhost:8000
